params {
    // Pipeline-level input/output. `input` is the raw source — it may NOT be a
    // zarr store (e.g. a raw acquisition that a convert step turns into zarr).
    // Individual step modules always operate on zarr (input_zarr/output_zarr).
    input             = null
    output            = null
    deskew_config     = null
    flat_field_config = null
    biahub_project    = null
    max_positions     = 0
    max_workers       = 100

    // QC (standalone qc.nf): drives the external imaging-qc CLI. `stages_manifest`
    // is a CSV (header: zarr_path,config_path) — one row runs one config on one zarr.
    stages_manifest   = null
    qc_project        = null   // local imaging-qc checkout for `uv run --project`; null uses the pinned release
    qc_config_dir     = null   // optional dir of per-stage configs for report-spec generation
    qc_chunk_size     = 10      // time-chunk size for wave-0 compute (0 = no chunking)
    qc_report_static  = false   // render a static (non-interactive) report
    qc_report_dir     = null   // defaults to ${output}/qc/report
}

process {
    executor = 'local'

    withLabel: 'cpu_local' {
        cpus   = 1
        memory = '8 GB'
    }
    withLabel: 'cpu' {
        cpus   = 4
        memory = '32 GB'
        time   = '2h'
    }
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        executor {
            name = 'slurm'
            queueSize = params.max_workers
            submitRateLimit = '50/1min'
        }
        process {
            executor = 'slurm'
            queue = 'cpu'

            withLabel: 'cpu_local' {
                executor = 'local'
                cpus   = 1
                memory = '12 GB'
            }
            withLabel: 'cpu' {
                queue = 'cpu'
            }
        }
    }
}

// Default work dir lives under the run's output. Override with Nextflow's
// native `-work-dir`/`-w` CLI flag (e.g. to use fast local scratch).
workDir = "${params.output}/nextflow/work"

dag {
    enabled   = true
    overwrite = true
    file      = "${params.output}/nextflow/dag.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.output}/nextflow/report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.output}/nextflow/trace.txt"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.output}/nextflow/timeline.html"
}
